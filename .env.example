# Copy this file to .env and fill in your real values.
# Never commit the real .env file — it is already listed in .gitignore.

# Your Resend API key. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The verified sender address emails are sent FROM.
# NOTE: this domain (regmedink.com) must be verified in your Resend
# dashboard before this will work in production. On Resend's free tier
# you can test with Resend's own sandbox domain instead.
FROM_EMAIL=hello@regmedink.com

# The internal address that receives new-signup notifications.
ADMIN_EMAIL=admin@regmedink.com
